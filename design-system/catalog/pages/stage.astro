---
import CatalogLayout from "../CatalogLayout.astro";
import Stage, { getHeadings } from "../stage.mdx";
---

<CatalogLayout
  title="Stage"
  about="A Stage before a choice, a Stage its catalog script has chosen and stepped through, so every mark shows on the drawing and the table, a Stage with two choice groups, a start vertex and a search, a Stage of typed input, as written and refusing a number, a Stage of typed text, a word over an alphabet whose examples include the empty word, a Stage tracing code, stepped to where every mark shows on its lines, and a Stage whose table grows a row per pass with `body`."
  headings={getHeadings()}
>
  <Stage />
</CatalogLayout>

<script>
  import { runCatalogStages } from "../stage-runs.ts";

  await runCatalogStages();
</script>
