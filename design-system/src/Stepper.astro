---
import "./figure-colours.css";
import InlineSvg from "./InlineSvg.astro";
import StepControls from "./StepControls.astro";
import { drawInStandard, inOneFrame, smallestLabelSize } from "./d2-board.ts";
import { brokenRule, unlessRuleBroken } from "./component-rules.ts";
import { inSteps, printedLines, steppedBlocks, steppedCode, steppedFigure } from "./stepper.ts";

interface Captioned {
  /**
   * One short caption per step (per code block, with one code block per step), in step order,
   * shown beside the buttons. Screen readers announce it with the step number and, for code, the
   * step's lines; without captions they hear only those. Leave it out only when the prose around
   * the stepper already explains each step.
   */
  captions?: string[];
}

interface Described {
  /** What the drawing shows as a whole, in a sentence or two. Screen readers read it. */
  alt: string;
}

interface DiagramSteps extends Captioned, Described {
  /**
   * The diagram's boards, imported with `?steps` from a `.d2` file next to the entry. The root
   * board is the first step, unless everything is drawn under `steps`, and each board in `steps`
   * is the next.
   */
  diagram: string[];
}

interface FigureSteps extends Captioned, Described {
  /**
   * The drawing, imported with `?raw` from an `.svg` file next to the entry. Each element with a
   * `data-step` shows only in the steps it lists: `data-step="2"` in step 2, `"2-4"` in steps 2 to
   * 4, `"2-"` from step 2 to the end, and `"1, 3"` in steps 1 and 3. Elements without one always
   * show. The highest step number named is the number of steps.
   */
  figure: string;
}

interface CodeSteps extends Captioned {
  /**
   * The lines each step highlights, one entry per step, by the numbers the page shows for them:
   * from 1, or from the fence's `start`. `"3"`, `"3-5"`, `"3-"` (line 3 to the end) or `"1-2, 6"`.
   * The other lines turn grey. Put one fenced code block inside the stepper, with blank lines
   * around it, and no `{…}` in its fence: `lines` marks the lines here.
   */
  lines: string[];
}

/**
 * Steps the owner through a mechanism, a diagram or a code walkthrough one step at a time, with
 * back and forward buttons above it. Use it when the order is the point: the stages of a process,
 * a drawing built up part by part, a program read a few lines at a time, or code rewritten step
 * by step. For a picture that reads at once, use `Diagram` or `Figure`.
 *
 * Give it one of `diagram`, `figure` or `lines`, or, for code that changes between steps, none of
 * them and one code block per step:
 *
 * ````mdx
 * import mitose from "./mitose.d2?steps";
 * import bomba from "./bomba.svg?raw";
 *
 * <Stepper diagram={mitose} alt="As quatro fases da mitose." captions={["Prófase", "Metáfase", "Anáfase", "Telófase"]} />
 *
 * <Stepper figure={bomba} alt="A bomba de sódio e potássio em três tempos." captions={["A bomba prende três Na⁺.", "Ela os solta fora da célula.", "Ela traz dois K⁺ para dentro."]} />
 *
 * <Stepper lines={["1", "2-3", "5"]} captions={["Recebe o raio.", "Calcula a área.", "Devolve."]}>
 *
 * ```ts
 * …
 * ```
 *
 * </Stepper>
 *
 * <Stepper captions={["Soma dentro do laço.", "Tira a soma do laço.", "Usa a fórmula."]}>
 *
 * ```pascal {3}
 * …
 * ```
 *
 * ```pascal {2-3}
 * …
 * ```
 *
 * ```pascal
 * …
 * ```
 *
 * </Stepper>
 * ````
 *
 * A D2 diagram steps through its `steps` boards, each drawn as a whole, in one frame the size of
 * the largest board: write every board so it reads on its own. Diagrams and drawings take their
 * colours as in `Diagram` and `Figure`. A stepper needs at least two steps, and `captions`, when
 * given, needs one caption per step.
 *
 * Code: use `lines` when the code stays the same and only the lines in play change; put one fenced
 * code block per step inside the stepper, with blank lines around each, when the code itself
 * changes between steps. Never draw code as a figure stepper, which loses its text and copying.
 * Each block stands alone, with its own language, `start` and numbers, and its fence's `{…}` marks
 * that step's lines: the rest turn grey, and a block without `{…}` shows in full ink. The stepper
 * doesn't compare blocks, so mark the lines that changed, or, before a deletion, the line about to
 * go in the step before. It shows one block at a time, in one frame as tall as the tallest block,
 * so stepping doesn't move the page. Screen readers hear the step number, the marked lines and the
 * caption.
 *
 * Printed, a stepper shows every step: each board, or each code block with its marks, under its
 * number and caption, and a one-block stepper's code with each step's lines and caption listed
 * under it. A figure whose parts are all in its last step prints once, at that step, with the
 * captions listed under it; one with a part that leaves before the end, such as a point moving
 * around an orbit, prints every step, each in the drawing's full frame under its number and
 * caption. For a figure that builds up, the last step is the complete drawing.
 */
type Props = DiagramSteps | FigureSteps | CodeSteps | Captioned;

const props = Astro.props;
const { captions } = props;
const alt = "alt" in props ? props.alt : "";

async function steps() {
  // TypeScript accepts a prop from another member of a union, so the types alone let two sources in.
  const sources = ["diagram", "figure", "lines"].filter((source) => source in props);
  if (sources.length > 1) {
    throw brokenRule(
      "Stepper",
      "give it one of `diagram`, `figure` or `lines`, or none of them and one fenced code block per step",
    );
  }
  const drawing = sources.find((source) => source !== "lines");
  if (drawing !== undefined && Astro.slots.has("default")) {
    throw brokenRule(
      "Stepper",
      `a \`${drawing}\` Stepper holds nothing inside it: give it the \`${drawing}\` alone, or none of \`diagram\`, \`figure\` or \`lines\` and one fenced code block per step`,
    );
  }

  let count: number;
  let boards: { svg: string; crop: string }[] | undefined;
  let figure: string | undefined;
  let figureSteps: string[] | undefined;
  let code: string | undefined;
  let blocks: string[] | undefined;
  let linesOfStep: number[][] | undefined;
  if ("diagram" in props) {
    const { frame, boards: framed } = inOneFrame(props.diagram.map(drawInStandard));
    boards = framed.map(({ svg, box }) => ({
      svg,
      crop: [
        `--frame-width: ${String(frame.width)}`,
        `--board-width: ${String(box.width)}`,
        `--board-height: ${String(box.height)}`,
        `--board-x: ${String(box.x - frame.x)}`,
        `--board-y: ${String(box.y - frame.y)}`,
      ].join("; "),
    }));
    count = boards.length;
  } else if ("figure" in props) {
    if (/fill-swatch-|data-swatch/.test(props.figure)) {
      throw brokenRule(
        "Stepper",
        "swatches are only for a Figure or a Stage, so a figure Stepper draws none: draw the colouring as a Figure, or step through it in a Stage",
      );
    }
    ({ svg: figure, count, printedSteps: figureSteps } = steppedFigure(props.figure));
  } else if ("lines" in props) {
    ({ html: code, linesOfStep } = steppedCode(await Astro.slots.render("default"), props.lines));
    count = props.lines.length;
  } else {
    blocks = steppedBlocks(await Astro.slots.render("default"));
    count = blocks.length;
  }

  // A diagram that failed has no boards, and its failure is already reported against the .d2 file.
  const diagramFailed = boards?.length === 0;
  if (!diagramFailed && count < 2) {
    throw brokenRule("Stepper", `it has ${String(count)} step; give it at least two`);
  }
  if (!diagramFailed && captions !== undefined && captions.length !== count) {
    throw brokenRule(
      "Stepper",
      `it has ${String(count)} steps but ${String(captions.length)} captions; give one caption per step`,
    );
  }

  const boardMinScale =
    boards && boards.length > 0
      ? Math.min(
          1,
          Math.max(1 / 2, 8 / Math.min(...boards.map(({ svg }) => smallestLabelSize(svg)))),
        )
      : undefined;
  const countWidth = `min-inline-size: ${String(String(count).length)}ch`;
  const printedSteps = linesOfStep
    ? linesOfStep.map((lines, index) => {
        const caption = captions ? `: ${captions[index] ?? ""}` : "";
        return {
          number: String(index + 1),
          en: `(${printedLines(lines, { line: "line", lines: "lines" })})${caption}`,
          pt: `(${printedLines(lines, { line: "linha", lines: "linhas" })})${caption}`,
        };
      })
    : figure &&
      !figureSteps &&
      captions?.map((caption, index) => ({
        number: `${String(index + 1)}.`,
        en: caption,
        pt: caption,
      }));
  return {
    diagramFailed,
    count,
    countWidth,
    boards,
    boardMinScale,
    figure,
    figureSteps,
    code,
    blocks,
    printedSteps,
  };
}

const stepper = await unlessRuleBroken(steps);
const marker = "marker" in stepper ? stepper.marker : undefined;
const shown = "marker" in stepper || stepper.diagramFailed ? undefined : stepper;
---

{marker !== undefined && <Fragment set:html={marker} />}
{shown && (
  <artifact-stepper class="stepper" data-count={shown.count}>
    <StepControls kind="stepper" class="stepper-controls">
      <p class="step-counter">
        <span class="stepper-current" style={shown.countWidth}>
          1
        </span>{" "}
        <span data-lang="en">of</span>
        <span data-lang="pt">de</span> {shown.count}{" "}
        {(shown.code ?? shown.blocks) && <span class="stepper-lines step-unseen" />}
      </p>
      {captions && (
        <div class="stepper-captions">
          {captions.map((caption, index) => (
            <p {...inSteps([index + 1])}>{caption}</p>
          ))}
        </div>
      )}
    </StepControls>
    {shown.boards && (
      <div class="stepper-stage stepper-boards">
        {shown.boards.map((board, index) => (
          <div {...inSteps([index + 1])}>
            <p class="stepper-step">
              <span class="stepper-step-number">{index + 1}.</span> {captions?.[index]}
            </p>
            <div class="stepper-board" style={board.crop}>
              <InlineSvg svg={board.svg} alt={alt} minScale={shown.boardMinScale} />
            </div>
          </div>
        ))}
      </div>
    )}
    {shown.figure && (
      <div class="stepper-stage stepper-figure figure">
        <InlineSvg svg={shown.figure} alt={alt} />
      </div>
    )}
    {shown.figureSteps && (
      <div class="stepper-figure-steps" aria-hidden="true">
        {shown.figureSteps.map((step, index) => (
          <div class="stepper-figure-step figure">
            <p class="stepper-step">
              <span class="stepper-step-number">{index + 1}.</span> {captions?.[index]}
            </p>
            <InlineSvg svg={step} />
          </div>
        ))}
      </div>
    )}
    {shown.code && <div class="stepper-stage stepper-code" set:html={shown.code} />}
    {shown.blocks && (
      <div class="stepper-stage stepper-blocks">
        {shown.blocks.map((block, index) => (
          <div {...inSteps([index + 1])}>
            <p class="stepper-step">
              <span class="stepper-step-number">{index + 1}.</span> {captions?.[index]}
            </p>
            <Fragment set:html={block} />
          </div>
        ))}
      </div>
    )}
    {shown.printedSteps && (
      <ol class="stepper-steps">
        {shown.printedSteps.map((step) => (
          <li class="stepper-step">
            <span class="stepper-step-number">{step.number}</span>{" "}
            <span data-lang="en">{step.en}</span>
            <span data-lang="pt">{step.pt}</span>
          </li>
        ))}
      </ol>
    )}
    <p class="stepper-announcement step-unseen" aria-live="polite"></p>
  </artifact-stepper>
)}

<script>
  import { inPageLanguage } from "./page-language.ts";
  import { lineRuns } from "./stepper.ts";

  const texts = {
    en: {
      step: (step: number, count: number) => `Step ${String(step)} of ${String(count)}.`,
      lines: { one: "Line", many: "Lines", to: "to", and: "and" },
    },
    pt: {
      step: (step: number, count: number) => `Passo ${String(step)} de ${String(count)}.`,
      lines: { one: "Linha", many: "Linhas", to: "a", and: "e" },
    },
  };

  function saidLines(lines: number[], words: (typeof texts)["en"]["lines"]): string {
    const runs = lineRuns(lines).map(({ from, to }) =>
      from === to ? String(from) : `${String(from)} ${words.to} ${String(to)}`,
    );
    const last = runs.pop() ?? "";
    const list = runs.length === 0 ? last : `${runs.join(", ")} ${words.and} ${last}`;
    return `${lines.length === 1 ? words.one : words.many} ${list}.`;
  }

  class ArtifactStepper extends HTMLElement {
    #step = 1;

    constructor() {
      super();
      this.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest("button");
        if (button === this.#part("button.stepper-back")) this.#go(-1);
        if (button === this.#part("button.stepper-forward")) this.#go(1);
      });
      this.addEventListener("keydown", (event) => {
        if (!(event.target instanceof HTMLButtonElement)) return;
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        this.#go(event.key === "ArrowLeft" ? -1 : 1);
      });
    }

    connectedCallback() {
      for (const button of this.querySelectorAll(".stepper-controls button")) {
        button.removeAttribute("disabled");
      }
      this.#show();
    }

    get #count(): number {
      return Number(this.dataset.count);
    }

    get #texts() {
      return inPageLanguage(this, texts);
    }

    #part(selector: string): HTMLElement {
      const part = this.querySelector<HTMLElement>(selector);
      if (part === null) throw new Error(`artifact-stepper has no ${selector}`);
      return part;
    }

    #go(by: number) {
      const step = Math.min(Math.max(this.#step + by, 1), this.#count);
      if (step === this.#step) return;
      this.#step = step;
      this.dataset.stepped = "";
      this.#show();
      this.#part(".stepper-announcement").textContent = [
        this.#texts.step(step, this.#count),
        this.querySelector(".stepper-lines")?.textContent,
        this.querySelector(".stepper-captions > :not([data-off])")?.textContent,
      ]
        .filter(Boolean)
        .join(" ");
    }

    #show() {
      const step = String(this.#step);
      for (const part of this.querySelectorAll<HTMLElement | SVGElement>("[data-in-steps]")) {
        const steps = (part.dataset.inSteps ?? "").split(" ");
        part.toggleAttribute("data-off", !steps.includes(step));
      }
      this.#part(".stepper-current").textContent = step;
      const lines = this.querySelector(".stepper-lines");
      if (lines !== null) {
        const block = this.querySelector(
          ".stepper-code pre, .stepper-blocks > :not([data-off]) > pre",
        );
        const lit = block?.matches("[data-marks]")
          ? [...block.querySelectorAll<HTMLElement>(".line:not([data-off])")].map((line) =>
              Number(line.dataset.line),
            )
          : [];
        lines.textContent = lit.length > 0 ? saidLines(lit, this.#texts.lines) : "";
      }
      this.#part("button.stepper-back").setAttribute("aria-disabled", String(this.#step === 1));
      this.#part("button.stepper-forward").setAttribute(
        "aria-disabled",
        String(this.#step === this.#count),
      );
    }
  }

  customElements.define("artifact-stepper", ArtifactStepper);
</script>

<style is:global>
  @layer components {
    artifact-stepper {
      display: block;
      margin-block: var(--block-clearance);
    }

    .stepper-captions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      min-inline-size: 0;

      > * {
        grid-area: 1 / 1;
      }
    }

    .stepper-code pre,
    .stepper-blocks pre {
      margin: 0;
    }

    /* Every block shares one grid cell, so the frame is as tall as the tallest, and each block
       stretches to it, so its rules stay where they are from step to step. */
    .stepper-blocks {
      display: grid;
      grid-template-columns: minmax(0, 1fr);

      > * {
        display: grid;
        grid-area: 1 / 1;
      }

      > [data-off] {
        visibility: hidden;
        opacity: 0;
      }
    }

    .stepper-boards,
    .stepper-figure {
      display: grid;
      place-items: center;
      padding-block: var(--space-3);
      border-block: var(--rule) solid var(--color-text);
      overflow-x: auto;
    }

    .stepper-boards > [data-off] {
      display: none;
    }

    .stepper-figure [data-off],
    .stepper-captions > [data-off] {
      visibility: hidden;
      opacity: 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      .stepper [data-in-steps] {
        transition:
          opacity 0.2s,
          visibility 0.2s;
      }

      /* Two blocks fading across each other would overlap their text, so a block leaves at once
         and the next fades in, as a board does. */
      .stepper-blocks > [data-off] {
        transition: none;
      }

      .stepper-code .line,
      .stepper-code .line > *,
      .stepper-code .line::before {
        transition: color 0.2s;
      }

      /* @starting-style also fires on page load, so the first board would fade in unasked. */
      .stepper[data-stepped] .stepper-boards > * {
        @starting-style {
          opacity: 0;
        }
      }
    }

    .stepper-controls {
      margin-block-end: var(--space-2);
    }

    .stepper-current {
      display: inline-block;
      text-align: end;
    }

    .stepper-captions > p {
      margin: 0;
      font-size: var(--font-size-frame);
    }

    .stepper-step,
    .stepper-steps,
    .stepper-figure-steps {
      display: none;
    }

    .stepper-step-number {
      font-family: var(--font-frame);
      font-stretch: var(--font-stretch-frame);
      font-size: var(--font-size-frame-small);
      font-weight: var(--font-weight-frame-strong);
      font-variant-numeric: tabular-nums;
    }

    @media print {
      .stepper [data-in-steps] {
        transition: none;
      }

      .stepper-controls {
        display: none;
      }

      /* The steps' lines are listed under the code, so it prints as a block that marks none. */
      .stepper-code .line {
        --code-line-colour: initial;

        &::before {
          color: var(--color-text-muted);
          font-weight: inherit;
        }
      }

      .stepper-boards {
        justify-items: stretch;
        row-gap: var(--space-4);

        > [data-off] {
          display: block;
        }

        > * {
          break-inside: avoid;
        }
      }

      .stepper-blocks {
        row-gap: var(--space-4);

        > * {
          display: block;
          grid-area: auto;
          break-inside: avoid;
        }

        > [data-off] {
          visibility: visible;
          opacity: 1;
        }
      }

      .stepper-step {
        display: block;
        margin: 0 0 var(--space-2);
        font-size: var(--font-size-frame);
      }

      /* Every board is drawn in the largest board's frame, which would print each early board with
         the empty space of the last one. In print, each is cut back to its own box. */
      .stepper-board {
        inline-size: min(100%, var(--board-width) * 1px);
        aspect-ratio: var(--board-width) / var(--board-height);
        margin-inline: auto;
        overflow: hidden;

        > svg {
          inline-size: calc(100% * var(--frame-width) / var(--board-width));
          max-inline-size: none;
          margin-block-start: calc(-100% * var(--board-y) / var(--board-width));
          margin-inline-start: calc(-100% * var(--board-x) / var(--board-width));
        }
      }

      .stepper-steps {
        display: block;
        margin: var(--space-2) 0 0;
        padding: 0;
        list-style: none;
        break-before: avoid;

        > .stepper-step {
          margin-block-end: var(--space-1);
        }
      }

      .stepper-figure {
        break-inside: avoid;
      }

      /* Printed once, a figure is at its last step, which holds every part. */
      .stepper-figure [data-in-steps] {
        visibility: visible;
        opacity: 1;
      }

      .stepper-figure:has(+ .stepper-figure-steps) {
        display: none;
      }

      .stepper-figure-steps {
        display: grid;
        row-gap: var(--space-4);
        padding-block: var(--space-3);
        border-block: var(--rule) solid var(--color-text);
      }

      .stepper-figure-step {
        break-inside: avoid;

        > svg {
          max-block-size: 70vh;
          inline-size: auto;
        }

        [data-off] {
          display: none;
        }
      }
    }
  }
</style>
