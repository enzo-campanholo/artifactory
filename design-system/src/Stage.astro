         zooms the page into a focused field set smaller. A field wider than its line shrinks to
         the line, alone on it. */
      &[data-kind="text"] > input {
        flex: 0 1 auto;
        font-family: var(--font-mono);
        font-size: var(--font-size-frame);
        font-variation-settings: "MONO" 1;
        font-variant-numeric: normal;
        text-align: start;
      }
    }

    .stage-say {
      font-size: var(--font-size-frame);
    }

