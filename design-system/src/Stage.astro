    }

    .stage-content > :first-child {
      margin-block-start: 0;
    }

    .stage-content > :last-child {
      margin-block-end: 0;
    }

    .stage-figure [data-choice] {
      cursor: pointer;
    }

    /* A part uncoloured as written holds an empty label for a step to fill, so its plate stays
