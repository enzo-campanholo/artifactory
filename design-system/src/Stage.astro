       would push the Stage past it; at 0 the field shrinks to the column instead. */
    .stage-input {
      min-inline-size: 0;
      margin: 0;
    }

    .stage-fields {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-3);
    }

    .stage-field {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      max-inline-size: 100%;
      font-family: var(--font-frame);
      font-stretch: var(--font-stretch-frame);
      font-size: var(--font-size-frame);
      font-weight: var(--font-weight-frame-strong);
      line-height: var(--line-height-frame);

      > input {
        box-sizing: border-box;
        inline-size: calc(var(--stage-field-width) * 1ch + 2 * var(--inset) + 2 * var(--stroke));
        min-inline-size: var(--target);
        min-block-size: var(--target);
        margin: 0;
        padding: 0 var(--inset);
        border: var(--stroke) solid var(--color-text);
        border-radius: 0;
        background: var(--color-surface);
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: var(--font-size-body);
        font-weight: var(--font-weight-body);
        font-variant-numeric: tabular-nums;
