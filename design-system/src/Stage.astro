      font-family: var(--font-frame);
      font-stretch: var(--font-stretch-frame);
      font-size: var(--font-size-frame-small);
      font-weight: var(--font-weight-frame);
      font-variant-numeric: tabular-nums;
      line-height: var(--line-height-frame);
    }

    .stage-example-label {
      margin-inline-end: var(--space-2);
      font-weight: var(--font-weight-frame-strong);
    }

    @media screen {
      .stage-controls:not([hidden]) + .stage-example {
        display: none;
      }
    }

    /* A table under the drawing shares its rule instead of drawing a second one. */
    .stage-figure:has(+ .stage-content > :first-child) {
      border-block-end: 0;
    }

    /* 64rem is where the step's line stops dropping under the counter, so a phone, a tablet and A4
       paper keep one column. Flex can't style a wrapped line, so the drawing keeps its lower rule
       and a table wrapped under it overlaps that rule. The tables' 999 to the drawing's 1 keeps the
       drawing at its own width beside them and lets it take the full width alone. */
    @media (width >= 64rem) {
      .stage[data-beside]:has(> .stage-figure):has(> .stage-content > .table-scroller):not(
          :has(> .stage-content > :not(.table-scroller))
        ) {
