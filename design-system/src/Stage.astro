      position: relative;
      display: inline-grid;
      place-items: center;
      box-sizing: border-box;
      min-inline-size: var(--target);
      min-block-size: var(--target);
      padding: 0 var(--inset);
      border: var(--stroke) solid var(--color-text);
      font-family: var(--font-frame);
      font-stretch: var(--font-stretch-frame);
      font-size: var(--font-size-frame);
      font-weight: var(--font-weight-frame-strong);
      line-height: var(--line-height-frame);
