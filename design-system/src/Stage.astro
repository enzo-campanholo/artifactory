       fire for every way of printing, so the marks exist only on screen. A part's hatching is
       drawn at the drawing's top, beyond its tokens' reach, so a mark or hover hands the part
       the hatching drawn in its state instead (swatches.ts). */
    @media screen {
      @media (hover: hover) and (forced-colors: none) {
        .stage-figure [data-choice]:hover:not([data-mark="reversed"]) {
          --color-surface: var(--color-surface-subtle);
          --swatch-1: var(--swatch-1-wiped);
          --swatch-2: var(--swatch-2-wiped);
          --swatch-3: var(--swatch-3-wiped);
          --swatch-4: var(--swatch-4-wiped);
          --swatch-5: var(--swatch-5-wiped);
          --swatch-6: var(--swatch-6-wiped);
        }

        .stage-figure [data-choice][data-mark="muted"]:hover {
          --swatch-1: var(--swatch-1-muted-wiped);
          --swatch-2: var(--swatch-2-muted-wiped);
          --swatch-3: var(--swatch-3-muted-wiped);
          --swatch-4: var(--swatch-4-muted-wiped);
          --swatch-5: var(--swatch-5-muted-wiped);
          --swatch-6: var(--swatch-6-muted-wiped);
        }
      }

      /* A mark changes a line's form, not only its colour, and goes through the colour classes'
         tokens, so both themes follow. */
      .stage-figure :is([data-mark="strong"], [data-mark="strong"] *)[class*="stroke-"] {
        stroke-width: 4;
      }

      .stage-figure :is([data-mark="strong"], [data-mark="strong"] *):is(text) {
        font-weight: var(--font-weight-frame-strong);
      }

      .stage-figure :is([data-mark="dashed"], [data-mark="dashed"] *)[class*="stroke-"] {
        stroke-dasharray: 6 4;
      }

      /* A step's colour is an attribute on the part, so print keeps the classes as written: its
         areas take the swatch, as a `fill-swatch-` class would fill them, and its plate shows.
         Uncoloured, its swatches take the ground and its label and plate hide. */
      .stage-figure
        [data-colour="1"]
        :is(.fill-surface, [class*="fill-swatch-"]):not([data-swatch-plate]) {
        fill: var(--swatch-1);
      }

      .stage-figure
        [data-colour="2"]
        :is(.fill-surface, [class*="fill-swatch-"]):not([data-swatch-plate]) {
        fill: var(--swatch-2);
      }

      .stage-figure
        [data-colour="3"]
        :is(.fill-surface, [class*="fill-swatch-"]):not([data-swatch-plate]) {
        fill: var(--swatch-3);
      }

      .stage-figure
        [data-colour="4"]
        :is(.fill-surface, [class*="fill-swatch-"]):not([data-swatch-plate]) {
        fill: var(--swatch-4);
      }

      .stage-figure
        [data-colour="5"]
        :is(.fill-surface, [class*="fill-swatch-"]):not([data-swatch-plate]) {
        fill: var(--swatch-5);
      }

      .stage-figure
        [data-colour="6"]
        :is(.fill-surface, [class*="fill-swatch-"]):not([data-swatch-plate]) {
        fill: var(--swatch-6);
      }

      .stage-figure [data-colour="none"] [class*="fill-swatch-"] {
        fill: var(--color-surface);
      }

      .stage-figure [data-colour]:not([data-colour="none"]) [data-swatch-plate] {
        visibility: visible;
      }

      .stage-figure [data-colour="none"] :is([data-swatch-plate], text[data-swatch]) {
        visibility: hidden;
      }

      /* A swatch drawn without an outline takes the mark's own, so every mark reads on it, as
         does a ground area a step colours. */
      .stage-figure
        :is([data-mark="strong"], [data-mark="strong"] *):is(
          [class*="fill-swatch-"],
          [data-colour]:not([data-colour="none"]) .fill-surface:not([data-swatch-plate])
        ):not([class*="stroke-"]) {
        stroke: var(--color-text);
        stroke-width: 4;
      }

      .stage-figure
        :is([data-mark="dashed"], [data-mark="dashed"] *):is(
          [class*="fill-swatch-"],
          [data-colour]:not([data-colour="none"]) .fill-surface:not([data-swatch-plate])
        ):not([class*="stroke-"]) {
        stroke: var(--color-text);
        stroke-width: 2;
        stroke-dasharray: 6 4;
      }

      /* Unclassed labels paint in currentColor, so the marks set the colour as well as the token. */
      .stage-figure [data-mark="muted"] {
        --color-text: var(--color-text-muted);
        --swatch-1: var(--swatch-1-muted);
        --swatch-2: var(--swatch-2-muted);
        --swatch-3: var(--swatch-3-muted);
        --swatch-4: var(--swatch-4-muted);
        --swatch-5: var(--swatch-5-muted);
        --swatch-6: var(--swatch-6-muted);
        color: var(--color-text-muted);
      }

      .stage-figure [data-mark="reversed"] {
        --color-text: var(--stage-ground);
        --color-surface: var(--stage-ink);
        --swatch-1: var(--stage-ink);
        --swatch-2: var(--stage-ink);
        --swatch-3: var(--stage-ink);
        --swatch-4: var(--stage-ink);
        --swatch-5: var(--stage-ink);
        --swatch-6: var(--stage-ink);
        color: var(--stage-ground);
      }

      .stage-figure :is([data-mark="reversed"], [data-mark="reversed"] *):is(text) {
        font-weight: var(--font-weight-frame-strong);
      }

      .stage-content :is(td, th)[data-mark="strong"] {
        font-weight: var(--font-weight-body-strong);
      }

      .stage-content :is(td, th)[data-mark="dashed"] {
        outline: var(--stroke) dashed var(--color-text);
        outline-offset: calc(-1 * var(--stroke));
      }

      .stage-content :is(td, th)[data-mark="muted"] {
        color: var(--color-text-muted);
      }

      .stage-content :is(td, th)[data-mark="reversed"] {
        background: var(--stage-ink);
        color: var(--stage-ground);
        font-weight: var(--font-weight-body-strong);
      }

      @media (forced-colors: active) {
        .stage-content :is(td, th)[data-mark="reversed"] {
          forced-color-adjust: none;
          background: CanvasText;
          color: Canvas;
        }

        .stage-content :is(td, th)[data-mark="muted"] {
          color: GrayText;
        }
      }

      /* Each code line is a row of a grid as wide as the longest line, so a marked line's box and
         the reversed bar run the code's whole scrolling width, not only what shows. The code
         block's inset moves into the lines so the bar reaches its edges. */
      .stage-content pre {
        padding-inline: 0;

        > code {
          display: grid;
          min-inline-size: max-content;
        }

        > code > .line {
          padding-inline: var(--inset);
        }
      }

      .stage-content .line:is([data-mark="muted"], [data-mark="reversed"]) {
        --astro-code-foreground: var(--stage-code);
        --astro-code-token-comment: var(--stage-code);
        --astro-code-token-keyword: var(--stage-code);
        --astro-code-token-function: var(--stage-code);
        --astro-code-token-parameter: var(--stage-code);
        --astro-code-token-string: var(--stage-code);
        --astro-code-token-string-expression: var(--stage-code);
        --astro-code-token-constant: var(--stage-code);
        --astro-code-token-punctuation: var(--stage-code);
        --astro-code-token-link: var(--stage-code);
        color: var(--stage-code);

        &::before {
          color: var(--stage-code);
        }
      }

      /* A strong line's number turns to ink too, so a comment line marked strong still shows. */
      .stage-content .line[data-mark="strong"] {
        font-weight: var(--font-weight-body-strong);

        &::before {
          color: var(--color-text);
        }
      }

      .stage-content .line[data-mark="dashed"] {
        outline: var(--stroke) dashed var(--color-text);
        outline-offset: calc(-1 * var(--stroke));
      }

      .stage-content .line[data-mark="muted"] {
        --stage-code: var(--color-text-muted);
      }

      .stage-content .line[data-mark="reversed"] {
        --stage-code: var(--stage-ground);
        background: var(--stage-ink);
        font-weight: var(--font-weight-body-strong);
      }

      @media (forced-colors: active) {
        .stage-content .line:is([data-mark="muted"], [data-mark="reversed"]) {
          forced-color-adjust: none;
        }

        .stage-content .line[data-mark="muted"] {
          --stage-code: GrayText;
        }

        .stage-content .line[data-mark="reversed"] {
          --stage-code: Canvas;
          background: CanvasText;
        }
      }

      .stage-as-written {
        display: none;
      }

      @media (prefers-reduced-motion: no-preference) {
        artifact-stage[data-stepped]
          :is(line, path, circle, rect, polygon, text, td, th, .line, .line > *),
        artifact-stage[data-stepped] .line::before {
          transition:
            stroke-width 0.2s,
            fill 0.2s,
            stroke 0.2s,
            color 0.2s,
            background-color 0.2s;
        }
      }
    }

    @media print {
      .stage-controls,
      .stage-step-text,
      .stage-step-row,
      .stage-figure [data-colour-fading] {
        display: none;
      }
    }
  }
</style>
