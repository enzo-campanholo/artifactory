---
import "./figure.css";
import InlineSvg from "./InlineSvg.astro";
import type { ruledInstance } from "./component-rules.ts";

interface Props {
  svg: string;
  alt: string;
  caption: string | undefined;
  class: "figure" | "diagram";
  minScale?: number;
  swatches?: boolean;
  instance?: ReturnType<typeof ruledInstance>;
}

const { svg, alt, caption, class: className, minScale, swatches, instance } = Astro.props;
const label =
  className === "figure" ? { en: "Figure", pt: "Figura" } : { en: "Diagram", pt: "Diagrama" };
---

<figure {...instance} class={className}>
  <div class="figure-stage">
    <InlineSvg
      svg={svg}
      alt={alt}
      minScale={minScale}
      swatches={swatches === true ? "plain" : undefined}
    />
  </div>
  <figcaption data-uncaptioned={caption === undefined ? "" : undefined}>
    <span class="figure-number">
      <span data-lang="en">{label.en}</span>
      <span data-lang="pt">{label.pt}</span>&#32;
    </span>
    {caption}
  </figcaption>
</figure>
