---
import { drawingParts } from "./inline-svg.ts";
import { platedLabels, swatchPatterns } from "./swatches.ts";

interface Props {
  svg: string;
  alt?: string | undefined;
  minScale?: number | undefined;
  swatches?: "plain" | "marked" | undefined;
  colours?: readonly string[] | undefined;
}

const { svg, alt, minScale = 2 / 3, swatches, colours } = Astro.props;

const { ownAttributes, drawing, viewBox } = drawingParts(svg);

// DESIGN.md's Square Corner Rule, for figures and D2's boxes alike.
const squared = drawing.replace(/<rect\b[^>]*>/g, (rect) =>
  rect.replace(/\s(?:rx|ry)\s*=\s*(?:"[^"]*"|'[^']*')/g, ""),
);

// Only a drawing that fills with swatches gets their patterns, and only one that labels colours
// gets plates, so every other drawing stays as written. A Stage's step can colour any part that
// holds a label, so a Stage drawing with one gets the patterns even if it's uncoloured as written.
const content = swatches === undefined ? squared : platedLabels(squared, colours);
const swatched =
  (swatches === "plain" && content.includes("fill-swatch-")) ||
  (swatches === "marked" && /fill-swatch-|data-swatch=/.test(content))
    ? swatchPatterns(swatches === "marked")
    : undefined;

// Without a size an inline SVG fills the column, which blows small drawings up. Its viewBox
// gives its natural size, and the stylesheet shrinks it to fit narrower screens, down to
// `minScale` of it so its labels stay at 8 px or more: two thirds for the 12-unit labels of a
// hand-written figure, and for a diagram whatever its smallest label allows. Narrower than that,
// the stage scrolls.
const [, , width, height] = viewBox.trim().split(/[\s,]+/);
const attributes =
  width === undefined || height === undefined
    ? { ...ownAttributes, viewBox }
    : { width, height, ...ownAttributes, viewBox };
const minWidthStyle =
  width === undefined
    ? undefined
    : `--min-drawing-width: ${String(Math.ceil(Number(width) * minScale))}px`;
---

<svg
  {...attributes}
  style={minWidthStyle}
  role={alt === undefined ? undefined : "img"}
  aria-label={alt}
  aria-hidden={alt === undefined ? "true" : undefined}
>
  <g
    aria-hidden="true"
    style={swatched?.style}
    set:html={swatched ? swatched.defs + content : content}
  />
</svg>

<style>
  @layer components {
    svg {
      display: block;
      min-inline-size: var(--min-drawing-width, 0);
      max-inline-size: 100%;
      block-size: auto;
      margin-inline: auto;
    }

    @media print {
      svg {
        min-inline-size: 0;
      }
    }
  }
</style>
