---
import LibraryLayout from "@artifactory/design-system/library-layout";
import { listedArtifacts } from "../library.ts";
---

<LibraryLayout
  heading="Drafts"
  empty="No drafts. An agent's draft is listed here until it's published."
  artifacts={await listedArtifacts({ drafts: true })}
  otherList={{ href: "/", label: "Library" }}
/>
